# Copy to .env and fill in. Never commit .env.
# Groq (OpenAI-compatible) LLM for explanations
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini for image understanding (optional; image upload is disabled without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Postgres (connection pooler URI; URL-encode special chars in the password)
DATABASE_URL=

# Cache tuning
CACHE_MAX_ITEMS=1000

# --- Reliability (defaults shown; all optional) ---
DB_POOL_MIN=1
DB_POOL_MAX=4                 # per worker process; Supabase poolers have small client limits
DB_POOL_TIMEOUT=1.0           # seconds to wait for a pooled connection
DB_STATEMENT_TIMEOUT_MS=1500
DB_WRITE_QUEUE_SIZE=1000      # background cache writes; extra writes are dropped, never block
DB_BREAKER_FAILURES=3
DB_BREAKER_COOLDOWN=30
LLM_MAX_CONCURRENCY=8
VISION_MAX_CONCURRENCY=4
EXTERNAL_QUEUE_TIMEOUT=2.0    # seconds a request waits for an LLM/vision slot before degrading

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true                 # set false for readable local logs
